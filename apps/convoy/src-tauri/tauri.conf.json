{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convoy",
  "version": "0.1.0",
  "identifier": "com.iftech.convoy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Convoy",
        "width": 1280,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run and review coding agents across projects",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MUJFQTNBMTdEOTM1RUYKUldUdk5ka1hPdW9iRlNGREJhQlRzRG12OWIvVWp1dXAxY0x2R01mSmJWOVV3YkdyZUsxM2g1TFAK",
      "endpoints": [
        "https://github.com/iftech-team/convoy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
