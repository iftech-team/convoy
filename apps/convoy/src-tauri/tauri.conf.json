{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convoy",
  "version": "0.1.0",
  "identifier": "com.iftech.convoy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Convoy",
        "width": 1280,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Run and review coding agents across projects",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
