{
  "name": "convoy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Convoy workspace for Claude Code and Codex on Windows and Linux",
  "author": "iftech-team",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:pty": "electron test/pty-smoke.cjs",
    "test:ui": "npm run build && electron test/ui-smoke.cjs",
    "test:app": "npm run build && electron test/app-smoke.cjs",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.iftech.convoy.desktop",
    "productName": "Convoy Preview",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*.cjs",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "src/telemetry.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "iftech-team"
    },
    "artifactName": "Convoy-Preview-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://peshbar.com/convoy",
  "repository": {
    "type": "git",
    "url": "https://github.com/iftech-team/convoy.git",
    "directory": "apps/desktop"
  }
}
